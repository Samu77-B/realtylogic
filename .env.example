# Neon Postgres (recommended) — Project Settings → Connection string → Pooled connection
DATABASE_URI=postgresql://USER:PASSWORD@ep-xxxx.eu-west-2.aws.neon.tech/neondb?sslmode=require

# Payload auth/session signing — use a long random string in production
PAYLOAD_SECRET=your-secret-key-change-in-production

# Vercel Blob (optional locally; auto-set on Vercel after adding Blob storage to the project)
# BLOB_READ_WRITE_TOKEN=

# Enquiry forms (contact + arrange a viewing) — Resend on Vercel
# Verify realtylogic.co.uk in Resend, then set From to an address on that domain.
# RESEND_API_KEY=
# ENQUIRY_TO_EMAIL=contact@realtylogic.co.uk
# ENQUIRY_FROM_EMAIL=Realty Logic <contact@realtylogic.co.uk>

# Realty AI (Vercel AI Gateway) — on Vercel, OIDC is preferred; locally you can set:
# AI_GATEWAY_API_KEY=

# Public site URL (used for Stripe Checkout/Portal return URLs)
# NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Stripe — CMS subscription (£25/month or £250/year)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID=price_...
# STRIPE_PRICE_ID_YEARLY=price_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Weekly “set up payment” reminder cron (Vercel sends this as Authorization: Bearer …)
# CRON_SECRET=
