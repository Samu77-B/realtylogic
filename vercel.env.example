# Copy these to Vercel → Project → Settings → Environment Variables
# Use the same values as your local .env file.

DATABASE_URI=postgresql://USER:PASSWORD@ep-xxxx.eu-west-2.aws.neon.tech/neondb?sslmode=require
PAYLOAD_SECRET=your-long-random-secret

# Add Vercel Blob storage to the project first — Vercel auto-generates this token.
BLOB_READ_WRITE_TOKEN=

# Enquiry forms (contact + arrange a viewing) — Resend
# Create an API key at https://resend.com and verify realtylogic.co.uk for production From addresses.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=contact@realtylogic.co.uk
ENQUIRY_FROM_EMAIL=Realty Logic <contact@realtylogic.co.uk>

# Realty AI — enable AI Gateway on the Vercel project (OIDC) or set a gateway key:
# AI_GATEWAY_API_KEY=

# Public site URL for Stripe return links
NEXT_PUBLIC_SERVER_URL=https://realtylogic.co.uk

# Stripe — CMS subscription (£25/month or £250/year — 2 months free)
# Webhook endpoint: https://realtylogic.co.uk/api/billing/webhook
# Events: checkout.session.completed, customer.subscription.updated, customer.subscription.deleted
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_PRICE_ID_YEARLY=price_1U3NDvIrjqATtdELcMV7CsaU
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
